FROM nvidia/cuda:12.5.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends     git python3 python3-venv python3-pip colmap vulkan-tools libvulkan1     && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/capture-splat
COPY . /workspace/capture-splat
RUN python3 -m venv .venv && . .venv/bin/activate && pip install --upgrade pip && pip install -e '.[dev,vision]'
CMD ["bash"]
